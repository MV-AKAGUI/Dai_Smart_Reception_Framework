#!/usr/bin/env python
import hashlib
from pathlib import Path
import re
import subprocess
import sys


def obter_raiz_repositorio() -> Path:
    try:
        res = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            capture_output=True,
            text=True,
            check=True
        )
        return Path(res.stdout.strip())
    except Exception:
        return Path.cwd()


def carregar_lista_revogados(raiz: Path) -> list[tuple[str, int, str]]:
    caminho_lista = raiz / "segredos_revogados.sha256"
    if not caminho_lista.is_file():
        return []
    
    entradas = []
    padrao = re.compile(r"^[a-f0-9]{64} \d+ (HDW_API_KEY|OVPN_TOKEN)$")
    for linha in caminho_lista.read_text(encoding="utf-8").splitlines():
        linha_limpa = linha.strip()
        if not linha_limpa or not padrao.match(linha_limpa):
            continue
        partes = linha_limpa.split()
        entradas.append((partes[0], int(partes[1]), partes[2]))
    return entradas


def obter_arquivos_staging(raiz: Path) -> list[str]:
    res = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "--diff-filter=ACM"],
        cwd=raiz,
        capture_output=True,
        text=True,
        check=True
    )
    return [linha.strip() for linha in res.stdout.splitlines() if linha.strip()]


def obter_conteudo_staging(raiz: Path, rel_path: str) -> str:
    res = subprocess.run(
        ["git", "show", f":{rel_path}"],
        cwd=raiz,
        capture_output=True,
        text=True
    )
    if res.returncode == 0:
        return res.stdout
    return ""


def main():
    raiz = obter_raiz_repositorio()
    entradas = carregar_lista_revogados(raiz)
    if not entradas:
        sys.exit(0)

    arquivos = obter_arquivos_staging(raiz)
    ocorrencias = []

    for arq in arquivos:
        conteudo = obter_conteudo_staging(raiz, arq)
        if not conteudo:
            continue

        for num_linha, linha in enumerate(conteudo.splitlines(), start=1):
            for hash_revogado, tam, _ in entradas:
                if len(linha) < tam:
                    continue
                for i in range(len(linha) - tam + 1):
                    pedaco = linha[i:i + tam]
                    if hashlib.sha256(pedaco.encode("utf-8")).hexdigest() == hash_revogado:
                        ocorrencias.append(f"{arq}:{num_linha}")
                        break

    if ocorrencias:
        for oc in ocorrencias:
            sys.stderr.write(f"Commit bloqueado: segredo revogado detectado em {oc}\n")
        sys.exit(1)

    sys.exit(0)


if __name__ == "__main__":
    main()
